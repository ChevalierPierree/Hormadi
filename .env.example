# Supabase PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/db?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/db"

# Auth (admin login)
JWT_SECRET="change-me-to-a-long-random-string"

# Site URL — currently unused by application code, kept for future absolute-URL needs (emails, OG tags)
NEXT_PUBLIC_SITE_URL="https://hormadi.vercel.app"

# Email (SMTP) — used for ticket/order confirmation emails and the contact form.
# Variable must be named SMTP_FROM (not EMAIL_FROM) — the code only reads SMTP_FROM.
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="you@example.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="you@example.com"

# Vercel Cron — optional. When set, /api/cron/* routes require this as a Bearer token
# in production. Leave unset to allow the daily sync-games / sync-standings crons to
# run without auth (current production setup).
CRON_SECRET=""
